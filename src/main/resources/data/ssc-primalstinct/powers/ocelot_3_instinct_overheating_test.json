{
  "type": "apoli:action_over_time",
  "name": "本能过热（测试）",
  "description": "每5秒检测10格内的代理攻击对象，50%概率触发30秒强制AI接管。",
  "interval": 100,
  "entity_action": {
    "type": "apoli:if_else",
    "condition": {
      "type": "apoli:and",
      "conditions": [
        {
          "type": "apoli:status_effect",
          "effect": "ssc-primalstinct:instinct_overheating",
          "inverted": true
        },
        {
          "type": "ssc-primalstinct:proxy_has_nearby_attack_target",
          "radius": 10.0
        }
      ]
    },
    "if_action": {
      "type": "apoli:chance",
      "chance": 0.5,
      "action": {
        "type": "apoli:apply_effect",
        "effect": {
          "effect": "ssc-primalstinct:instinct_overheating",
          "duration": 600,
          "amplifier": 0,
          "show_particles": false,
          "show_icon": true
        }
      }
    }
  }
}
